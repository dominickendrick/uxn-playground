( the guardian - text viewer )
( splash screen: renders "The Guardian" banner, no interaction yet )

( macros )

%RTN { JMP2r }

( devices )

|00 @system     [ &Vector $2 &pad    $6 &R      $2 &G     $2 &B      $2 ]
|20 @screen     [ &Vector $2 &Width  $2 &Height $2 &auto  $1 &pad    $1
                  &X      $2 &Y      $2 &Addr   $2 &pixel $1 &sprite $1 ]
|80 @controller [ &Vector $2 &button $1 &key    $1 ]
|90 @mouse      [ &Vector $2 &X      $2 &Y     $2 &state $1 ]

( variables )

|0000

@banner [ &x $2 &y $2 ]        ( top-left of current glyph )
@str    [ &ptr $2 ]            ( cursor into the message )
@px     [ &x $2 &y $2 ]        ( top-left of current scaled block )
@gp     [ &addr $2 &row $1 &col $1 &bits $1 ]
@fnt    [ &base $2 &h $1 ]     ( active font: data address + glyph height )
@pointer [ &x $2 &y $2 ]      ( last drawn cursor position )
@txt    [ &ptr $2 &x $2 &y $2 &color $1 ]  ( cursor + blend for the 1x sprite text )
@hover  $1                    ( headline under the pointer, ff = none )

( program )

|0100 ( -> )

    ( theme: white bg, black ink, grey highlight (colour 2) )
    #f0a0 .system/R DEO2
    #f0a0 .system/G DEO2
    #f0a0 .system/B DEO2

    ( screen size )
    #0200 .screen/Width DEO2
    #0110 .screen/Height DEO2

    ( pick a font: terminus (8x16) is taller and has lowercase )
    ;font-terminus .fnt/base STZ2
    #10 .fnt/h STZ

    ( draw the masthead, centred )
    ;message #0058 #0018 ;draw-string JSR2

    ( draw the headline list )
    ;draw-news JSR2

    ( no headline hovered yet )
    #ff .hover STZ

    ( mouse cursor )
    ;on-mouse .mouse/Vector DEO2

BRK

@on-mouse ( -> )

    ( erase the previous cursor from the foreground )
    .pointer/x LDZ2 .screen/X DEO2
    .pointer/y LDZ2 .screen/Y DEO2
    ;cursor/clear .screen/Addr DEO2
    #40 .screen/sprite DEO

    ( draw the cursor at the new mouse position )
    .mouse/X DEI2 DUP2 .pointer/x STZ2 .screen/X DEO2
    .mouse/Y DEI2 DUP2 .pointer/y STZ2 .screen/Y DEO2
    ;cursor .screen/Addr DEO2
    #45 .screen/sprite DEO

    ( highlight the headline under the pointer )
    ;hit-test JSR2
    DUP .hover LDZ NEQ ?&changed
        POP BRK
    &changed
        ( repaint the previously hovered headline in the normal colour )
        .hover LDZ #ff EQU ?&skip-old
            #01 .txt/color STZ
            .hover LDZ ;draw-headline-n JSR2
        &skip-old
        DUP .hover STZ
        #ff EQU ?&done
            #02 .txt/color STZ
            .hover LDZ ;draw-headline-n JSR2
        &done

BRK

@hit-test ( -- index )

    ( which headline block (if any) is the mouse y over? )
    .mouse/Y DEI2
    DUP2 #0050 LTH2 ?&none
    DUP2 #0078 LTH2 ?&b0
    DUP2 #0080 LTH2 ?&none
    DUP2 #00a8 LTH2 ?&b1
    DUP2 #00b0 LTH2 ?&none
    DUP2 #00d8 LTH2 ?&b2
    DUP2 #00e0 LTH2 ?&none
    DUP2 #0108 LTH2 ?&b3
    &none POP2 #ff JMP2r
    &b0 POP2 #00 JMP2r
    &b1 POP2 #01 JMP2r
    &b2 POP2 #02 JMP2r
    &b3 POP2 #03 JMP2r

@cursor    [ 80c0 e0f0 f8e0 1000 ]
    &clear [ ffff ffff ffff ffff ]

@draw-string ( msg* x* y* -- )

    .banner/y STZ2
    .banner/x STZ2
    .str/ptr STZ2

    &loop
        .str/ptr LDZ2 LDA
        DUP #00 EQU ?&done
        ;draw-char JSR2
        .banner/x LDZ2 #001c ADD2 .banner/x STZ2
        .str/ptr LDZ2 INC2 .str/ptr STZ2
        !&loop
    &done
        POP RTN

@draw-char ( char -- )

    ( glyph = fnt/base + (char - 20) * fnt/h )
    #20 SUB #00 SWP .fnt/h LDZ #00 SWP MUL2 .fnt/base LDZ2 ADD2 .gp/addr STZ2

    #00 .gp/row STZ
    &row
        .gp/addr LDZ2 .gp/row LDZ #00 SWP ADD2 LDA .gp/bits STZ
        #00 .gp/col STZ
        &col
            #80 .gp/col LDZ SFT .gp/bits LDZ AND #00 EQU ?{
                .gp/col LDZ #00 SWP #0003 MUL2 .banner/x LDZ2 ADD2 .px/x STZ2
                .gp/row LDZ #00 SWP #0003 MUL2 .banner/y LDZ2 ADD2 .px/y STZ2
                ;draw-block JSR2
            }
            .gp/col LDZ INC DUP .gp/col STZ #08 LTH ?&col
        .gp/row LDZ INC DUP .gp/row STZ .fnt/h LDZ LTH ?&row

RTN

@draw-block ( -- )

    ( fill a 3x3 block of ink at px, one row at a time )
    .px/y LDZ2 .screen/Y DEO2
    .px/x LDZ2 DUP2 .screen/X DEO2 #01 .screen/pixel DEO
    INC2 DUP2 .screen/X DEO2 #01 .screen/pixel DEO
    INC2 .screen/X DEO2 #01 .screen/pixel DEO

    .px/y LDZ2 INC2 .screen/Y DEO2
    .px/x LDZ2 DUP2 .screen/X DEO2 #01 .screen/pixel DEO
    INC2 DUP2 .screen/X DEO2 #01 .screen/pixel DEO
    INC2 .screen/X DEO2 #01 .screen/pixel DEO

    .px/y LDZ2 #0002 ADD2 .screen/Y DEO2
    .px/x LDZ2 DUP2 .screen/X DEO2 #01 .screen/pixel DEO
    INC2 DUP2 .screen/X DEO2 #01 .screen/pixel DEO
    INC2 .screen/X DEO2 #01 .screen/pixel DEO

RTN

( headlines )

@draw-news ( -- )

    #01 .txt/color STZ
    #00 ;draw-headline-n JSR2
    #01 ;draw-headline-n JSR2
    #02 ;draw-headline-n JSR2
    #03 ;draw-headline-n JSR2

RTN

@draw-headline-n ( index -- )

    ( look up the block's three strings + y from the table )
    #00 SWP #30 SFT2 ;blocks ADD2 ,&e STR2
    ,&e LDR2 LDA2
    ,&e LDR2 #0002 ADD2 LDA2
    ,&e LDR2 #0004 ADD2 LDA2
    ,&e LDR2 #0006 ADD2 LDA2
    ;draw-headline JSR2

RTN
    &e $2

@draw-headline ( l1* l2* date* y* -- )

    ,&y STR2
    ,&date STR2
    ,&l2 STR2
    ,&l1 STR2

    ( two wrapped lines in the headline font )
    ;font-terminus .fnt/base STZ2 #10 .fnt/h STZ
    ,&l1 LDR2 #0010 ,&y LDR2 ;put-text JSR2
    ,&l2 LDR2 #0010 ,&y LDR2 #0010 ADD2 ;put-text JSR2

    ( date in the smaller font, below the headline )
    ;font-atari8 .fnt/base STZ2 #08 .fnt/h STZ
    ,&date LDR2 #0010 ,&y LDR2 #0020 ADD2 ;put-text JSR2

RTN
    &l1 $2 &l2 $2 &date $2 &y $2

@put-text ( str* x* y* -- )

    .txt/y STZ2
    .txt/x STZ2
    .txt/ptr STZ2

    &loop
        .txt/ptr LDZ2 LDA
        DUP #00 EQU ?&done
        ;put-glyph JSR2
        .txt/x LDZ2 #0008 ADD2 .txt/x STZ2
        .txt/ptr LDZ2 INC2 .txt/ptr STZ2
        !&loop
    &done
        POP RTN

@put-glyph ( char -- )

    ( glyph = fnt/base + (char - 20) * fnt/h )
    #20 SUB #00 SWP .fnt/h LDZ #00 SWP MUL2 .fnt/base LDZ2 ADD2
    .txt/x LDZ2 .screen/X DEO2
    .txt/y LDZ2 .screen/Y DEO2
    .fnt/h LDZ #10 EQU ?&tall
        ( 8px font: one tile )
        .screen/Addr DEO2
        .txt/color LDZ .screen/sprite DEO
        RTN
    &tall
        ( 16px font: top tile then bottom tile )
        DUP2 .screen/Addr DEO2
        .txt/color LDZ .screen/sprite DEO
        #0008 ADD2 .screen/Addr DEO2
        .txt/y LDZ2 #0008 ADD2 .screen/Y DEO2
        .txt/color LDZ .screen/sprite DEO
        RTN

( data )

( ascii string, 00-terminated )
@message "The 20 "Guardian $1

( headline table: three string pointers + top y per block )
@blocks
    =headline0/l1 =headline0/l2 =headline0/date 0050
    =headline1/l1 =headline1/l2 =headline1/date 0080
    =headline2/l1 =headline2/l2 =headline2/date 00b0
    =headline3/l1 =headline3/l2 =headline3/date 00e0

( headline list: two wrapped lines + an uppercase date each )
@headline0
    &l1   "Land 20 "deal 20 "saves 20 "Okefenokee 20 "swamp $1
    &l2   "from 20 "titanium 20 "mine $1
    &date "26 20 "JULY 20 "2026 $1
@headline1
    &l1   "South 20 "Africa's 20 "top 20 "court 20 "blocks $1
    &l2   "Shell 20 "oil 20 "exploration 20 "off 20 "Wild 20 "Coast $1
    &date "17 20 "AUGUST 20 "2026 $1
@headline2
    &l1   "Global 20 "land-use 20 "emissions 20 "have 20 "fallen $1
    &l2   "by 20 "about 20 "a 20 "third 20 "since 20 "late 20 "1990s $1
    &date "17 20 "AUGUST 20 "2026 $1
@headline3
    &l1   "First 20 "Nations 20 "win 20 "back 20 "the $1
    &l2   "world's 20 "oldest 20 "rainforest $1
    &date "16 20 "AUGUST 20 "2026 $1

